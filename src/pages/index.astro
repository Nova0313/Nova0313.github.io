---
import BaseLayout from '../layouts/BaseLayout.astro';
import LongContent from '../components/LongContent.astro';
import { site } from '../data/site';
---

<BaseLayout isHome>
  <section class="explore-hero" aria-labelledby="hero-title">
    <div class="wrap explore-top">
      <div class="explore-copy">
        <div class="eyebrow-line"><span class="eyebrow-dot"></span> 研究 · 战略 · 构建 <span class="eyebrow-en">RESEARCH / STRATEGY / BUILD</span></div>
        <h1 id="hero-title">你好，我是 <span>钱辰</span><small>Chen Qian</small></h1>
        <p>从交通与自动驾驶研究出发，走向 AI 战略与产品实践，也亲手把想法做成工具。</p>
        <div class="explore-meta">东南大学交通运输工程硕博连读 <span aria-hidden="true">·</span> AI 战略与产品实践方向</div>
        <div class="explore-actions">
          <a class="button button-primary" href="/experience/">查看经历 <span aria-hidden="true">↗</span></a>
          {site.resume ? <a class="button button-light" href={site.resume} download>下载简历 <span aria-hidden="true">↓</span></a> : <span class="button button-muted" aria-label="新版简历尚未提供，下载暂不可用">简历待更新 <span aria-hidden="true">↓</span></span>}
          <a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="explore-instruction"><span class="instruction-spark" aria-hidden="true">✳</span><strong>欢迎来到我的小窝</strong><p>点击房间中的物件，了解每个栏目；也可以用顶部导航直接前往。</p></div>
    </div>
    <div class="wrap room-wrap">
      <div class="room-caption"><span>CHEN'S STUDIO / 像素小窝</span><span>点击房间里的物件探索 <span aria-hidden="true">↘</span></span></div>
      <div class="room-stage">
        <img class="room-image" src="/images/studio-pixel-v2.png" width="512" height="384" alt="黑白灰像素风双层小窝：窗外有局部蓝色河景，室内有研究桌、白板、电脑；窗边坐着白色比熊和小体灰色泰迪" fetchpriority="high" />
        <a class="room-object object-experience" href="/experience/" data-room="experience" aria-label="一楼电脑桌：了解实习经历"></a>
        <a class="room-object object-beyond" href="/beyond/" data-room="beyond" aria-label="一楼的小狗：了解研究之外"></a>
        <a class="room-object object-research" href="/research/" data-room="research" aria-label="一楼电视墙书架：了解研究经历"></a>
        <a class="room-object object-projects" href="/projects/" data-room="projects" aria-label="二楼电脑桌：了解个人项目"></a>
        <svg class="room-effects" viewBox="0 0 512 384" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <g class="fx fx-experience">
            <path class="monitor-scan" d="M222 222h27M261 233h24" stroke="#9ed8db" stroke-width="2" shape-rendering="crispEdges" />
            <path class="monitor-code" d="M223 228h10m3 0h7m18 11h9m3 0h8" stroke="#b9e3df" stroke-width="2" shape-rendering="crispEdges" />
            <rect class="desk-pixel" x="301" y="267" width="4" height="4" fill="#d4ae6f" />
            <rect class="desk-pixel" x="311" y="263" width="3" height="3" fill="#d4ae6f" />
          </g>
          <g class="fx fx-beyond" shape-rendering="crispEdges">
            <path class="dog-tail tail-white" d="M120 231h-4v-3h-3" fill="none" stroke="#f6f5f0" stroke-width="3" />
            <path class="dog-tail tail-gray" d="M153 231h4v-3h3" fill="none" stroke="#777572" stroke-width="3" />
            <path class="dog-spark spark-one" d="M132 206h3v-3h3v3h3v3h-3v3h-3v-3h-3z" fill="#d5ad72" />
            <path class="dog-spark spark-two" d="M154 211h2v-2h2v2h2v2h-2v2h-2v-2h-2z" fill="#d5ad72" />
          </g>
          <g class="fx fx-research" shape-rendering="crispEdges">
            <g class="book-pull"><rect x="368" y="205" width="7" height="17" fill="#d4b378" stroke="#333635" stroke-width="1"/><rect x="369" y="207" width="5" height="3" fill="#f2efe8"/><rect x="370" y="217" width="3" height="2" fill="#f2efe8"/></g>
            <path class="book-spark" d="M355 189h2v-2h2v2h2v2h-2v2h-2v-2h-2z" fill="#d4b378" />
          </g>
          <g class="fx fx-projects" shape-rendering="crispEdges">
            <path class="upper-screen" d="M286 70h23v13h-23z" fill="#91b8bf" opacity=".4" />
            <path class="upper-code" d="M289 74h8m-8 4h13m-2-4h5" stroke="#d8f0eb" stroke-width="2" />
            <rect class="upper-pixel" x="313" y="61" width="3" height="3" fill="#d3ad70" />
            <rect class="upper-pixel" x="322" y="55" width="2" height="2" fill="#d3ad70" />
          </g>
        </svg>
      </div>
      <div class="room-legend" aria-label="小窝栏目入口"><a href="/experience/" data-room="experience">一楼电脑桌 · 实习经历</a><a href="/beyond/" data-room="beyond">小狗 · 研究之外</a><a href="/research/" data-room="research">电视墙书架 · 研究经历</a><a href="/projects/" data-room="projects">二楼电脑桌 · 个人项目</a></div>
      <div class="room-bottom"><span>点击物件会播放一段小动画，再打开栏目简介</span><span>可用键盘 Tab 选择物件</span></div>
    </div>
    <div class="wrap quick-work"><span class="quick-title">代表案例</span><a href="/cases/baidu/">百度 AI 战略 <span aria-hidden="true">↗</span></a><a href="/cases/swiftraj/">SWIFTraj <span aria-hidden="true">↗</span></a><a href="/cases/tokenviewer/">TokenViewer <span aria-hidden="true">↗</span></a></div>
  </section>

  <dialog id="room-dialog" class="room-dialog" aria-labelledby="room-dialog-title" aria-describedby="room-dialog-summary">
    <form method="dialog"><button class="dialog-close" aria-label="关闭栏目简介">×</button></form>
    <span class="dialog-kicker">EXPLORE / 小窝探索</span>
    <h2 id="room-dialog-title"></h2>
    <p id="room-dialog-summary"></p>
    <a id="room-dialog-link" class="dialog-link" href="/experience/">查看详情 <span aria-hidden="true">↗</span></a>
  </dialog>

  <div id="long-content" hidden><LongContent /></div>
  <noscript><style>#long-content[hidden]{display:block!important}</style></noscript>
  <script>
    const entries = {
      research: { title: '研究经历与成果', summary: '从网联与自动驾驶车辆研究出发，参与 SWIFTraj 开放数据集建设，并发表交通领域研究论文。', href: '/research/' },
      experience: { title: '实习经历', summary: '在百度做 AI 战略洞察与拓新工具，在亚信参与 Agent 产品设计和效果评测。', href: '/experience/' },
      projects: { title: '个人项目', summary: '亲手构建 TokenViewer 和 bosszhipin-search，把真实使用中的问题做成可用工具。', href: '/projects/' },
      beyond: { title: '研究之外', summary: '白色比熊、小体灰色泰迪、游戏、体育舞蹈和寺庙义工，是研究工作之外的日常。', href: '/beyond/' },
    } as const;
    const dialog = document.querySelector<HTMLDialogElement>('#room-dialog');
    const title = document.querySelector<HTMLElement>('#room-dialog-title');
    const summary = document.querySelector<HTMLElement>('#room-dialog-summary');
    const link = document.querySelector<HTMLAnchorElement>('#room-dialog-link');
    const roomStage = document.querySelector<HTMLElement>('.room-stage');
    let busy = false;
    document.querySelectorAll<HTMLAnchorElement>('[data-room]').forEach(object => {
      const key = object.dataset.room as keyof typeof entries;
      object.addEventListener('pointerenter', () => { if (roomStage) roomStage.dataset.preview = key; });
      object.addEventListener('pointerleave', () => { if (roomStage?.dataset.preview === key) delete roomStage.dataset.preview; });
      object.addEventListener('focus', () => { if (roomStage) roomStage.dataset.preview = key; });
      object.addEventListener('blur', () => { if (roomStage?.dataset.preview === key) delete roomStage.dataset.preview; });
      object.addEventListener('click', event => {
        const item = entries[key];
        if (!item || !dialog || !title || !summary || !link) return;
        event.preventDefault();
        if (busy) return;
        busy = true;
        if (roomStage) roomStage.dataset.active = key;
        title.textContent = item.title;
        summary.textContent = item.summary;
        link.href = item.href;
        window.setTimeout(() => {
          if (roomStage) delete roomStage.dataset.active;
          dialog.showModal();
          busy = false;
        }, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 650);
      });
    });
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    const toggle = document.querySelector<HTMLButtonElement>('#view-toggle');
    const longContent = document.querySelector<HTMLElement>('#long-content');
    function setLongMode(enabled: boolean, move = true) {
      if (!toggle || !longContent) return;
      longContent.hidden = !enabled;
      toggle.setAttribute('aria-pressed', String(enabled));
      toggle.setAttribute('aria-label', enabled ? '切回小窝探索' : '切换为长页浏览');
      const label = toggle.querySelector('span');
      if (label) label.textContent = enabled ? '小窝探索' : '长页浏览';
      if (move) (enabled ? longContent : document.body).scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }
    toggle?.addEventListener('click', () => setLongMode(longContent?.hidden ?? true));
    if (['#experience','#research','#projects','#beyond'].includes(location.hash)) {
      setLongMode(true, false);
      requestAnimationFrame(() => document.querySelector(location.hash)?.scrollIntoView());
    }
  </script>
</BaseLayout>
